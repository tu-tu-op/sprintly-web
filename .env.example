# Public Supabase values are safe to expose in the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional compatibility name for older Supabase projects.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only values. Never put these in client code or the extension.
SUPABASE_SERVICE_ROLE_KEY=

# Development-only extension authentication. Use only with NODE_ENV=development.
SPRINTLY_EXTENSION_DEV_TOKEN=
SPRINTLY_EXTENSION_DEV_USER_ID=00000000-0000-0000-0000-000000000001

# Optional contract/runtime overrides.
SPRINTLY_CONTRACT=devstrava.session.v1
SPRINTLY_SCHEMA_VERSION=1
SPRINTLY_EXTENSION_PAIRING_TTL_SECONDS=600
SPRINTLY_SESSION_RETENTION_DAYS=365

